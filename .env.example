# ==============================================================================
# CCTV SOS System - Environment Configuration Template (.env.example)
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าคอนฟิกจริง: cp .env.example .env
# ==============================================================================

# ─── MongoDB Atlas Configuration ──────────────────────────────────────────────
# Connection string สำหรับเชื่อมต่อ MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=iam
MONGODB_INCIDENTS_COLLECTION=Incidents

# ─── Environment Mode ─────────────────────────────────────────────────────────
# development: อนุญาต tlsAllowInvalidCertificates สำหรับการทดสอบ
# production: บังคับใช้ TLS/SSL Certificate ที่ถูกต้องอย่างปลอดภัย
APP_ENV=development

# ─── Snapshot & Webhook Configuration ─────────────────────────────────────────
# URL ของ Model Server สำหรับเสิร์ฟภาพ Snapshot ย้อนหลัง (เช่น http://127.0.0.1:8000 หรือ http://model_server:8000 ใน docker)
SNAPSHOT_SERVER_URL=http://127.0.0.1:8000
SAVE_LOCAL_SNAPSHOTS=true

# Webhook URL สำหรับส่งการแจ้งเตือน Real-time ขอความช่วยเหลือ (เช่น Discord, Slack, LINE Notify หรือ API กลาง)
HELP_WEBHOOK_URL=

# ─── Event Bridge & Ingest API ────────────────────────────────────────────────
# direct: เขียนข้อมูลตรงเข้า MongoDB Atlas
# api: ส่งผ่าน REST Ingest API
EVENT_BRIDGE_MODE=direct
IAM_INGEST_URL=https://your-api-gateway/api/events

# ─── RTSP Crypto & Security ───────────────────────────────────────────────────
# Key สำหรับถอดรหัส AES-256-GCM ของ URL กล้อง RTSP ที่ดึงมาจาก cctv_cameras collection
RTSP_SECRET=your_32_character_hex_or_secret_here
AI_SERVICE_KEY=your_service_auth_token_here

# ─── Optional Runtime Overrides ───────────────────────────────────────────────
SOS_DB_PATH=logs/sos_events.db
FORCE_RECORD_ALERTS=false
